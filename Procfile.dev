web: bin/rails server
css: bin/rails tailwindcss:watch
runner: bin/match_runner
# The egress consumers: progression and the incident feed. Separate from the runner on purpose
# — the runner needs a non-blocking poll inside its own tick loop, these are genuinely
# message-driven, and a slow or broken consumer must never be able to hold up a match.
events: bundle exec karafka server
