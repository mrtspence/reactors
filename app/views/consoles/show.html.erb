<% content_for :title, "Reactor — #{@operation_id.to_s.titleize}" %>

<% content_for :left do %>
  <% if @places.boxed? %>
    <%= render Frame::PlacesComponent.new(places: @places, operation_id: @operation_id) %>
  <% end %>
  <%= render Frame::PlaceholderComponent.new(region: :minimap) %>
<% end %>

<% here = @places.seated(@minions) %>
<div class="p-4 flex flex-col gap-4" data-controller="crew"
     data-crew-places-value="<%= @panel.fetch(:places).to_h { |place| [ place.fetch(:id), place.fetch(:label) ] }.to_json %>"
     data-crew-stations-value="<%= @places.stations.to_json %>"
     data-crew-fallback-value="<%= @places.fallback %>">
  <% @places.each_with_index do |place, index| %>
    <%= render PlacePanelComponent.new(place:, shown: index.zero?, here: here.fetch(place.id, []), minions: @minions,
                                       stations: @panel.fetch(:stations), places_known: @panel.fetch(:places).any?) %>
  <% end %>

  <%# How to start this machine, if it has a note of its own: one partial per kind. %>
  <% if lookup_context.exists?("consoles/notes/#{@kind}", [], true) %>
    <%= render "consoles/notes/#{@kind}" %>
  <% end %>
</div>
