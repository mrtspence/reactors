<% content_for :title, "Reactor — Outfitting" %>

<div class="min-h-screen w-full bg-slate-900 text-slate-100">

  <header class="flex items-center gap-4 px-4 py-3 border-b border-slate-800">
    <h1 class="text-sm uppercase tracking-widest text-slate-300">
      Outfitting
      <span class="text-slate-500">/ <%= @outfitting.chassis.to_s.tr("_", " ") %></span>
    </h1>

    <div class="grow"></div>

    <%= link_to "Back to the console",
                console_path(match_id: params[:match_id], operation_id: params[:operation_id]),
                class: "text-xs px-3 py-1 rounded bg-slate-800 hover:bg-slate-700 " \
                       "ring-1 ring-slate-700" %>
  </header>

  <main class="p-4 max-w-5xl">

    <%# **Everything that depends on the selection lives inside one frame**, both verdicts
        included. Changing a dropdown posts the form to the DRAFT resource, Turbo swaps the
        frame, and the page neither scrolls nor reloads. The verdict is the reason this is a
        round trip at all: only the simulation can say whether a build assembles, so a
        client-side preview could update the stats and would have to leave the warnings stale,
        which is worse than not previewing them. %>
    <%# The controller sits on the FRAME rather than the form, because Turbo replaces the
        frame's contents on each draft — a controller on the form would be torn down and
        rebuilt every time, where one here survives and simply re-scans. %>
    <%= turbo_frame_tag "outfitting",
                        data: { controller: "outfit",
                                outfit_draft_url_value: loadout_draft_path(
                                  match_id: params[:match_id],
                                  operation_id: params[:operation_id]
                                ) } do %>

    <%# **Two verdicts, deliberately kept apart.** "You do not own this" and "this will not run"
        are different failures with different fixes, and merging them into one list would make
        the first unactionable — a player would go looking for a wiring problem that is not
        there. See `docs/design_sketches/blueprints.md` §6. %>
    <% if @outfitting.locked.any? || @outfitting.chassis_locked? %>
      <section class="mb-4 rounded border border-violet-800 bg-violet-950/40 p-3">
        <h2 class="text-xs uppercase tracking-widest text-violet-300 mb-2">
          Not in your workshop
        </h2>
        <ul class="text-sm text-violet-100 space-y-1 list-disc list-inside">
          <%# The frame first, because it is the larger purchase and because every part on the
              page is fitted to it. %>
          <% if @outfitting.chassis_locked? %>
            <li>You have not unlocked the <%= @outfitting.chassis_label %> frame.</li>
          <% end %>
          <% @outfitting.locked.each do |part| %>
            <li>You have not unlocked the <%= part.label %>.</li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <%# Errors refuse the build; warnings never do — that split is the game's risk/reward axis
        rather than two severities, and the page has to make it obvious which one a player is
        looking at. %>
    <% if @outfitting.errors.any? %>
      <section class="mb-4 rounded border border-rose-800 bg-rose-950/40 p-3">
        <h2 class="text-xs uppercase tracking-widest text-rose-300 mb-2">
          This will not run
        </h2>
        <ul class="text-sm text-rose-100 space-y-1 list-disc list-inside">
          <% @outfitting.errors.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if @outfitting.warnings.any? %>
      <section class="mb-4 rounded border border-amber-900 bg-amber-950/30 p-3">
        <h2 class="text-xs uppercase tracking-widest text-amber-300 mb-2">
          It will run. Whether you should is your business.
        </h2>
        <ul class="text-sm text-amber-100/90 space-y-1 list-disc list-inside">
          <% @outfitting.warnings.each do |warning| %>
            <li><%= warning %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <%# **The form's own action is FIT**, so the primary action works with no JavaScript at all.
        Previewing is what the Stimulus controller overrides, and previewing is inherently a
        scripted feature — it fires on `change`. Degrading to "no live preview" is right;
        degrading to "cannot fit anything" would not be. %>
    <%#
       **`authenticity_token:` is explicit, and without it the draft 422s.**

       Rails mints *per-form* CSRF tokens by default: the token is scoped to the form's declared
       action and method. This form declares the loadout path as a PATCH, and the preview posts
       the same form to the draft path — so a per-form token would be minted for the wrong
       action and verification would refuse it.

       Passing `form_authenticity_token` with no form options supplies the **global** session
       token instead, which Rails accepts for any action. A request spec cannot catch this:
       CSRF verification is off in the test environment, so it passes there and 422s in a
       browser. It was found by driving the real server.
    %>
    <%= form_with url: loadout_path(match_id: params[:match_id],
                                    operation_id: params[:operation_id]),
                  method: :patch, authenticity_token: form_authenticity_token,
                  data: { outfit_target: "form" } do %>

      <%# **The frame, and it is a choice rather than an environment variable now.**
          It sits above the slots because it decides what slots there are: the atmospheric frame
          has a condenser and the high-pressure one does not, so changing this changes the page
          below it. Parts carry across where the new frame has a slot of the same kind — fitting
          a locomotive boiler to a beam engine is legal and is meant to be — and a slot only the
          new frame has arrives fitted with its default. %>
      <section class="mb-6">
        <h2 class="text-xs uppercase tracking-widest text-slate-300 border-b border-slate-700 pb-1 mb-1">
          The Frame
        </h2>
        <p class="text-xs text-slate-500 mb-3">
          What everything else bolts to. Changing it rebuilds the machine around your parts.
        </p>

        <div class="rounded border border-slate-800 bg-slate-800/40 p-3
                    flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <label class="text-sm font-medium text-slate-200" for="chassis">Chassis</label>
          <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-slate-700 text-slate-300">required</span>

          <% if @outfitting.chassis_locked? %>
            <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-violet-900/70 text-violet-200">locked</span>
          <% end %>

          <div class="grow"></div>

          <select name="chassis" id="chassis" data-action="change->outfit#preview"
                  class="text-sm bg-slate-900 border border-slate-700 rounded px-2 py-1 text-slate-100">
            <% @outfitting.chassis_choices.each do |frame| %>
              <% blueprint = Blueprint.fetch(:chassis, Outfitting.blueprint_id_for(frame)) %>
              <option value="<%= frame %>" <%= "selected" if frame == @outfitting.chassis %>>
                <%= blueprint.label %><%= " (locked)" if frame == @outfitting.chassis && @outfitting.chassis_locked? %>
              </option>
            <% end %>
          </select>
        </div>
      </section>

      <% @outfitting.slots.group_by(&:group).each do |group, slots| %>
        <% meta = slot_group(group) %>
        <section class="mb-6">
          <h2 class="text-xs uppercase tracking-widest <%= meta[:accent] %> border-b <%= meta[:rule] %> pb-1 mb-1">
            <%= meta[:label] %>
          </h2>
          <p class="text-xs text-slate-500 mb-3"><%= meta[:blurb] %></p>

          <div class="space-y-2">
            <% slots.each do |slot| %>
              <% fitted = @outfitting.part(slot.id) %>
              <%# An empty optional slot is SHOWN as empty rather than hidden. Seeing the hole
                  where a fusible plug would go is the point of the screen. %>
              <div class="rounded border <%= fitted ? "border-slate-800 bg-slate-800/40" : "border-slate-700 border-dashed bg-slate-900" %> p-3">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <label class="text-sm font-medium text-slate-200"
                         for="loadout_<%= slot.id %>"><%= slot.label %></label>

                  <% if slot.required? %>
                    <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-slate-700 text-slate-300">required</span>
                  <% else %>
                    <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-slate-800 text-slate-400">optional</span>
                  <% end %>

                  <% if fitted&.wip %>
                    <%# A part that is deliberately half-built says so, rather than being
                        presented as finished. The blower is free and will not stay free. %>
                    <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-amber-900/60 text-amber-200">work in progress</span>
                  <% end %>

                  <% if fitted && @outfitting.locked?(fitted) %>
                    <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-violet-900/70 text-violet-200">locked</span>
                  <% end %>

                  <div class="grow"></div>

                  <%# **Only what the player owns**, plus whatever is already fitted even if they
                      no longer own it — hiding that would make the error above impossible to
                      act on. This is a courtesy and not a gate: the form is a plain POST and
                      `Outfitting#locked` is what actually refuses the build. %>
                  <select name="loadout[<%= slot.id %>]" id="loadout_<%= slot.id %>"
                          data-action="change->outfit#preview"
                          class="text-sm bg-slate-900 border border-slate-700 rounded px-2 py-1 text-slate-100">
                    <% unless slot.required? %>
                      <option value="" <%= "selected" if fitted.nil? %>>— nothing fitted —</option>
                    <% end %>
                    <% @outfitting.available(slot).each do |candidate| %>
                      <option value="<%= candidate.id %>" <%= "selected" if fitted&.id == candidate.id %>>
                        <%= candidate.label %><%= " (locked)" if @outfitting.locked?(candidate) %>
                      </option>
                    <% end %>
                  </select>
                </div>

                <% if fitted %>
                  <p class="mt-2 text-xs text-slate-400"><%= fitted.description %></p>

                  <% if fitted.stats.any? %>
                    <dl class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
                      <% fitted.stats.each do |name, value| %>
                        <div class="flex gap-1">
                          <dt><%= name.to_s.tr("_", " ") %></dt>
                          <dd class="text-slate-300 tabular-nums"><%= part_stat(value) %></dd>
                        </div>
                      <% end %>
                    </dl>
                  <% end %>
                <% else %>
                  <p class="mt-2 text-xs text-slate-500 italic">Nothing fitted here.</p>
                <% end %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <div class="sticky bottom-0 -mx-4 px-4 py-3 bg-slate-900/95 border-t border-slate-800 flex items-center gap-3">
        <%# `data-turbo-frame="_top"` breaks the submission out of the frame, so the redirect to
            the console navigates the whole page rather than trying to render a console inside a
            frame. %>
        <button type="submit" data-turbo-frame="_top"
                class="text-sm px-4 py-1.5 rounded bg-emerald-800 hover:bg-emerald-700
                       ring-1 ring-emerald-600 cursor-pointer">
          Fit and test drive
        </button>
        <p class="text-xs text-slate-500">
          Fitting rebuilds the engine from cold. Whatever she was doing, she stops doing it.
        </p>
      </div>
    <% end %>
    <% end %>
  </main>
</div>
