<section class="rounded-lg bg-slate-800/60 ring-1 ring-slate-700 p-3">
  <h2 class="text-[11px] uppercase tracking-wide text-slate-400 mb-2">Crew</h2>
  <ul class="flex flex-col gap-2">
    <% minions.each do |minion| %>
      <li class="flex items-center gap-2 text-sm" data-minion-id="<%= minion.id %>">
        <span class="flex flex-col grow min-w-0">
          <span class="text-slate-200 truncate"><%= minion.name %></span>
          <span class="text-[10px] uppercase tracking-wide text-slate-500">
            <%= minion.id.to_s.tr("_", " ") %>
          </span>
        </span>
        <%# Filled in from the projection, which is the only thing that knows. Empty until the
            first view arrives, rather than pre-rendering a guess that would be wrong. %>
        <span class="text-[10px] uppercase tracking-wide text-rose-400 hidden"
              data-minion-injury></span>
        <select class="bg-slate-900 text-slate-200 text-xs rounded px-1 py-0.5 ring-1 ring-slate-700"
                data-minion-station data-action="change->console#assign">
          <option value="">— stood down —</option>
          <% controls.each do |control| %>
            <option value="<%= control.fetch(:id) %>"><%= control.fetch(:label) %></option>
          <% end %>
        </select>
      </li>
    <% end %>
  </ul>
</section>
