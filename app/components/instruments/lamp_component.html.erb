<figure class="rounded-lg bg-slate-800/60 ring-1 ring-slate-700 p-3 flex items-center gap-3"
        data-instrument-id="<%= id %>" data-instrument-kind="lamp"
        data-instrument-colour="<%= colour_class %>">
  <span class="h-4 w-4 rounded-full bg-slate-700 ring-1 ring-slate-600 transition"
        data-instrument-lamp></span>
  <figcaption class="text-[11px] uppercase tracking-wide text-slate-400"><%= label %></figcaption>
  <span class="sr-only" data-instrument-value><%= placeholder %></span>
</figure>
