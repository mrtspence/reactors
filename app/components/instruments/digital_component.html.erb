<figure class="rounded-lg bg-slate-800/60 ring-1 ring-slate-700 p-3 flex flex-col gap-1 justify-between"
        data-instrument-id="<%= id %>" data-instrument-kind="digital">
  <figcaption class="text-[11px] uppercase tracking-wide text-slate-400"><%= label %></figcaption>
  <div class="flex items-baseline gap-1">
    <span class="text-2xl font-semibold tabular-nums text-emerald-300"
          data-instrument-value><%= placeholder %></span>
    <% if unit %><span class="text-xs text-slate-400"><%= unit %></span><% end %>
  </div>
</figure>
